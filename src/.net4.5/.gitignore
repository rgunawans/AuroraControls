## Ignore Visual Studio temporary files, build results, and files generated by popular extensions.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.slnx.docstates

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache
.vs/

# Test results
[Tt]est[Rr]esults/
*.coverage
*.coveragexml

# NuGet packages
*.nupkg
packages/
*.snupkg

# Others
*.dbmdl
*.bak
*.tmp
*.temp
*.pidb
*.svclog
*.scc
